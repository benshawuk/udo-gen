{
  "name": "udo-gen",
  "version": "0.0.1",
  "description": "Schema-first code generator for Laravel + React. One UDO file replaces N hand-maintained artifacts.",
  "type": "module",
  "license": "MIT",
  "author": "Ben Shaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benshawuk/udo-gen.git"
  },
  "homepage": "https://github.com/benshawuk/udo-gen#readme",
  "bugs": "https://github.com/benshawuk/udo-gen/issues",
  "keywords": [
    "laravel",
    "react",
    "code-generation",
    "scaffolding",
    "schema-first",
    "crud",
    "udo"
  ],
  "bin": {
    "udo": "./bin/udo"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "eta": "^3.5.0",
    "jsonc-parser": "^3.3.1",
    "kleur": "^4.1.5",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pluralize": "^0.0.33",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  }
}

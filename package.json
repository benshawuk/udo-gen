{
  "name": "udo-gen",
  "version": "0.0.1",
  "description": "Schema-first code generator for Laravel + React. One UDO file replaces N hand-maintained artifacts.",
  "type": "module",
  "bin": {
    "udo": "./bin/udo"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "eta": "^3.5.0",
    "jsonc-parser": "^3.3.1",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}

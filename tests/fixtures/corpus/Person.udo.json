{
  "$schema": "../../../schema/udo-v1.schema.json",
  "udoVersion": 1,
  "resource": "Person",
  "table": "people",
  "fields": {
    "first_name": { "type": "string", "required": true, "max": 100 },
    "last_name": { "type": "string", "required": true, "max": 100 },
    "email": { "type": "string", "format": "email", "nullable": true },
    "company_id": {
      "type": "foreignId",
      "nullable": true,
      "references": "companies.id",
      "onDelete": "set null"
    },
    "ssn": { "type": "uuid", "format": "uuid", "nullable": true, "unique": true }
  }
}
